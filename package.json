{
  "name": "iris-restaurant",
  "version": "1.0.0",
  "private": true,
  "description": "Веб-приложение ресторана «Лотос»: меню, заказы, бронирование столов и роли пользователей",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "db:init": "ts-node src/scripts/init-db.ts",
    "db:seed": "ts-node src/scripts/seed-db.ts",
    "db:triggers": "ts-node src/scripts/apply-triggers.ts",
    "db:migrate": "ts-node src/scripts/migrate.ts"
  },
  "keywords": [
    "restaurant",
    "express",
    "postgresql",
    "typescript"
  ],
  "author": "Иконникова Д.И.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
