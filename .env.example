# Скопируйте этот файл в .env и укажите свои параметры подключения.
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=iris_restaurant
DB_USER=postgres
DB_PASSWORD=postgres

# Секрет для подписи cookie сессии. В продакшене замените на случайную строку.
SESSION_SECRET=iris_restaurant_dev_secret_change_me
